{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "auth:schema": "npx @better-auth/cli generate --config src/auth.ts --output src/schema.auth.ts -y",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "test": "vitest run",
    "inspect": "tsx --env-file=.env scripts/inspect.ts",
    "set-role": "tsx --env-file=.env scripts/set-role.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.9.0",
    "@smsk/shared": "workspace:^",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.0",
    "jose": "^6.0.0",
    "pg": "^8.23.0",
    "rrule": "^2.8.1",
    "zod": "^4",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  },
  "exports": {
    "./app": "./src/app.ts"
  }
}
